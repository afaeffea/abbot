CARTESIA_API_KEY=
OPENAI_API_KEY=

CARTESIA_VERSION=2026-03-01
CARTESIA_STT_MODEL=ink-whisper
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_LANGUAGE=ru
# Оставьте пустым, чтобы бэкенд сам выбрал первый доступный голос для CARTESIA_LANGUAGE
CARTESIA_VOICE_ID=

LLM_MODEL=gpt-4.1-mini

# Оставьте оба поля пустыми, чтобы отключить логирование в Google Sheets —
# без них приложение работает как обычно, просто без этой записи.
# Инструкция по получению обоих значений — в README.md.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Телефония (Voximplant) — инструкция по настройке в README.md.
# Общий секрет между Voximplant и нами: проверяет входящий WS-мост
# (/ws/telephony?token=...) и защищает POST /api/telephony/call
# (заголовок X-Telephony-Token). Тот же самый должен быть указан в
# секрете BACKEND_WS_TOKEN на стороне Voximplant.
TELEPHONY_WS_TOKEN=
# Account ID и API key — Control Panel → Settings/API.
VOXIMPLANT_ACCOUNT_ID=
VOXIMPLANT_API_KEY=
# ID routing rule, привязанного к сценарию voximplant/scenarios/outbound.voxengine.js.
VOXIMPLANT_OUTBOUND_RULE_ID=
# Арендованный номер, с которого звонит бот (caller ID для исходящих).
VOXIMPLANT_CALLER_ID=
# ID двух сценариев в панели Voximplant. Нужны scripts/deploy_voximplant.py,
# который заливает туда код из voximplant/ с подставленными доменом, токеном
# и номером — вручную копировать код в редактор не нужно.
VOXIMPLANT_OUTBOUND_SCENARIO_ID=
VOXIMPLANT_INBOUND_SCENARIO_ID=
# Домен бэкенда без схемы, например abbot-production-xxxx.up.railway.app.
# На Railway подставляется автоматически; локально нужен для того же
# deploy_voximplant.py — сценарий должен знать, куда открывать WebSocket.
RAILWAY_PUBLIC_DOMAIN=

# --- Выбор поставщика распознавания и синтеза (backend/speech.py) ---
# cartesia (по умолчанию) | yandex. Меняются независимо друг от друга.
STT_PROVIDER=cartesia
TTS_PROVIDER=cartesia

# Нужны, только если что-то из двух выше = yandex.
# Ключ сервисного аккаунта Yandex Cloud с ролью ai.speechkit-stt.user
# и/или ai.speechkit-tts.user; folder_id -- из консоли Yandex Cloud.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Голос синтеза Яндекса -- ИМЯ (alena/jane/omazh/...), а не UUID Cartesia.
# Голос из настроек бота (voice_id) для Яндекса не применяется.
YANDEX_TTS_VOICE=alena
YANDEX_TTS_ROLE=
# Скорость речи. 1.0 (умолчание Яндекса) на 21% медленнее голоса Cartesia,
# который он заменил -- на живом звонке это слышно как затянутость. 1.25
# чуть быстрее прежнего. Меняется без деплоя.
YANDEX_TTS_SPEED=1.25
YANDEX_STT_MODEL=general
YANDEX_STT_LANGUAGE=ru-RU
